    "INDEX-BIG5.TXT": {
      "url": "https://encoding.spec.whatwg.org/index-big5.txt",
      "sha256": "804ec2688abb23dec196c9b3df4b3a2fa3282f4f9cbf4c170435dda28c7e5719",
      "bytes": 262498,
      "head": [
        "# Big5 as the Encoding Standard decodes it: index-big5 of https://encoding.spec.whatwg.org/,",
        "# as carried by the tables encoding_rs 0.8.35 generates from it (BIG5_LOW_BITS, BIG5_ASTRALNESS).",
        "# Each line is a two-byte code and its code point. A pointer of the index is",
        "# (lead - 0x81) * 157 + (trail - 0x40, or trail - 0x62 from 0xA1). The codes 8862, 8864, 88A3 and",
        "# 88A5 decode to two code points and are listed last, as comments."
      ],
      "written_from": "the tables encoding_rs 0.8.35 generates from the index (BIG5_LOW_BITS, BIG5_ASTRALNESS); the sha256 is this file's, not the index file's"
    }
