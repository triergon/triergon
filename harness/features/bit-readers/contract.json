  "schema": 1,
  "id": "bit-readers",
  "candidate": "codec-views-worker",
  "operation": "bits",
  "gate": "required",
  "contract": [
    "Compare the value or refusal, consumed bit position and overrun after each scripted field read, peek, skip, alignment or Rice operation.",
    "The direct MSB reader receives eight zero padding bytes with its logical end set before them. The cached MSB reader zero-extends the input. The checked MSB cursor refuses fields and skips that cross the end without advancing.",
    "The LSB reader follows Vorbis bit order, including the sticky overrun and the retained low word of a wide field crossing the packet end. Rice codes compare the folded unsigned value from unary quotient and low bits.",
    "Zero and full-width fields, read widths outside the method domain, parameter overflow and both sides of the buffer end have explicit rows."
  ],
  "required_profiles": [
    "direct",
    "cached",
    "checked",
    "lsb",
    "rice"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "parity_timeout_seconds": 45,
