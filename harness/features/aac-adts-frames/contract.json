{
  "schema": 1,
  "id": "aac-adts-frames",
  "gate": "required",
  "operation": "aac-adts-frames",
  "candidate": "framing-views-worker",
  "worker_operation": "adts-",
  "runner": "cargo xtask report",
  "reference": "ffmpeg-framing-views-native",
  "contract": [
    "Walk physical ADTS extents with inspect_adts_header and parse each with AacAdtsParser. The reference opens a raw AAC demuxer without stream discovery, reads each packet and filters it with aac_adtstoasc.",
    "Fold kind 2 with the length and exact bytes of the candidate ASC header projection and reference ASC, initially or when the filter reports an update. Fold kind 1 with source offset, input frame length, object type, sampling index, channel configuration, protection-absent flag, payload length and exact payload bytes. For channel configuration zero or an empty frame body, use the demuxed header's two-byte ASC projection and the original payload, including any in-band PCE. Otherwise the reference projects the configuration fields from the active ASC and the protection flag from the demuxed header.",
    "Fold kind 7 with the frame count on clean end or kind 8 with the source offset on refusal or leftover input. Operate on preloaded bytes and include parser, demuxer and filter setup and teardown."
  ],
  "required_profiles": [
    "authored",
    "fate"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "iterations": 50,
  "minimum_pairs": 30,
  "confidence": 0.95,
  "open_deviations": [
    {
      "reading": "ADTS frame_length bounds the complete frame",
      "clause": "ISO/IEC 13818-7 clause 6.2 (ADTS syntax), from the repository's ADTS wire parser and framing README (aac_frame_length includes header, CRC when present and payload)",
      "candidate": "refuses a final frame that ends before its declared byte extent",
      "reference": "returns the short final payload through the AAC demuxer and filter",
      "compat": "compat::aac::return_truncated_adts_tail",
      "cases": [
        "truncated-crc-10",
        "truncated-8",
        "foo"
      ]
    },
    {
      "reading": "Only one raw_data_block belongs to the selected frame parser",
      "clause": "ISO/IEC 13818-7 clause 6.2 (ADTS syntax), from the repository's ADTS wire parser and framing README (number_of_raw_data_blocks_in_frame)",
      "candidate": "refuses a header declaring two raw blocks",
      "reference": "returns the unprotected payload without splitting the two declared blocks",
      "cases": [
        "two-blocks-unprotected"
      ]
    },
    {
      "reading": "ADTS layer is zero",
      "clause": "ISO/IEC 13818-7 clause 6.2 (ADTS syntax), from the repository's ADTS wire parser and framing README (adts_fixed_header layer)",
      "candidate": "refuses layer 1",
      "reference": "returns the payload",
      "cases": [
        "layer-1"
      ]
    },
    {
      "reading": "The frame parser selects the AAC-LC profile",
      "clause": "ISO/IEC 13818-7 clause 6.2 (ADTS syntax), from the repository's ADTS wire parser and framing README (adts_fixed_header profile, profile_ObjectType) and AacAdtsParser's selected grammar",
      "candidate": "refuses non-LC profiles before emitting a source frame",
      "reference": "emits other MPEG audio object types and returns payloads",
      "cases": [
        "profile-0",
        "profile-2",
        "profile-3",
        "am00_88",
        "am05_44",
        "ap05_48"
      ]
    }
  ],
