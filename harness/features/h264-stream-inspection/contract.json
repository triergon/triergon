{
  "schema": 1,
  "id": "h264-stream-inspection",
  "gate": "required",
  "operation": "h264-stream-inspection",
  "candidate": "codec-views-worker",
  "worker_operation": "h264-inspect-",
  "runner": "cargo xtask report",
  "reference": "ffmpeg-codec-views-native",
  "contract": [
    "Compare the parsed stream features with the trace_headers filter over the packets of the H.264 demuxer. Parse its published syntax element log and apply H.264 inference for fields that are not coded.",
    "Emit kind 3 records in StreamFeatures order. Each field emits its tag and number of values, then sorted tag/value/auxiliary rows. Coded size and bitstream restriction use value pairs. Parse error presence is folded; implementation-specific diagnostic text is not compared."
  ],
  "required_profiles": [
    "h264"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "parity_timeout_seconds": 240,
  "iterations": 1,
  "minimum_pairs": 30,
  "confidence": 0.95,
