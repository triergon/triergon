{
  "schema": 1,
  "id": "isobmff-segment-indexes",
  "gate": "required",
  "operation": "isobmff-segment-indexes",
  "candidate": "isobmff-views-worker",
  "worker_operation": "index-",
  "oracle": "isobmff-index",
  "contract": [
    "Read the named index box at the supplied byte offset and length, using the supplied work quantum. Compare each row with the independent ISO BMFF field oracle.",
    "For sidx, kind 2 records version, reference ID, timescale, initial presentation ticks, first offset and count. Each kind 3 entry records ordinal, reference type, range start and exclusive end, high and low words of the accumulated presentation ticks, duration ticks, starts-with-SAP bit, SAP type and delta, and the original size and SAP words.",
    "For tfra, kind 2 records version, track ID, entry count and the three coordinate widths. Each kind 3 entry records ordinal, time in ticks, moof offset and the traf, trun and sample numbers.",
    "For mfro, kind 2 records version and the stated parent size, start and exclusive end. Verify that the range locates an mfra with the original mfro at its tail.",
    "Kind 7 marks completion. Kind 8 marks a rejected box or entry after any rows already emitted."
  ],
  "required_profiles": [
    "sidx",
    "tfra",
    "mfro"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "iterations": 1,
