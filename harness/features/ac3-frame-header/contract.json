  "runner": "cargo xtask report",
  "reference": "ffmpeg-codec-views-native",
  "contract": [
    "Compare each AC-3 and E-AC-3 syncframe header with av_ac3_parse_header and the AC-3 parser’s packet boundaries, including dependent syncframes in grouped packets.",
    "Fold kind 3 with source offset, syntax, bitstream ID, declared byte extent, rate, audio block count, audio coding mode, LFE flag and actual byte extent. Fold kind 8 with offset on a refused syncframe. The fixed wire header supplies coded rate, blocks, coding mode and LFE independently of the parser’s context at drain."
  ],
  "required_profiles": [
    "ac3",
    "eac3",
    "authored"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "parity_timeout_seconds": 180,
  "iterations": 1,
  "minimum_pairs": 30,
