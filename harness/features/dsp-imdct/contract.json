{
  "schema": 1,
  "id": "dsp-imdct",
  "candidate": "codec-views-worker",
  "operation": "dsp",
  "gate": "required",
  "contract": [
    "Compare every sample of both the full inverse MDCT and DCT-IV with the independent float64 cosine definitions and the documented projection of the public av_tx inverse float MDCT.",
    "Every supported output length through 8192 uses scales 1 and 1/N, one seeded coefficient vector and first and last impulses. Follow the imdct_float numeric rule.",
    "A length refused by av_tx is compared with the cosine definitions. Reference discrepancies are kept as open cases and never waive the definition comparison."
  ],
  "required_profiles": [
    "imdct"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "parity_timeout_seconds": 45,
  "iterations": 1,
  "reference": "ffmpeg-codec-views-native",
  "runner": "cargo xtask codecs dsp",
  "open_deviations": [
    {
      "reading": "The public av_tx inverse MDCT at lengths whose output departs from the transform's definition",
      "clause": "The inverse MDCT the AAC, Vorbis and Opus specifications define: x[n] is a scale times the sum over the N/2 coefficients of X[k] cos(2 pi (n + 1/2 + N/4)(k + 1/2) / N), with the DCT-IV it reduces to",
      "candidate": "agrees with the float64 cosine definitions of both transforms at every length and input, within 4.27e-8 normalized",
      "reference": "after the documented sign and symmetry projection, differs from the definition at these 19 lengths by 0.024 to 0.72 normalized (largest at N 4, 7500 and 300); the 91 other lengths agree within 1.6e-8",
      "cases": [
        "n-0004", "n-0012", "n-0020", "n-0036", "n-0060", "n-0180",
        "n-0300", "n-0360", "n-0540", "n-0720", "n-0900", "n-1440",
        "n-1500", "n-1620", "n-2880", "n-4500", "n-4860", "n-5760",
        "n-7500"
      ],
      "targets": [
        "aarch64-unknown-linux-gnu"
      ]
    }
  ],
