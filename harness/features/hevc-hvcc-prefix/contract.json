  "schema": 1,
  "id": "hevc-hvcc-prefix",
  "gate": "required",
  "operation": "hevc-hvcc-prefix",
  "candidate": "framing-views-worker",
  "worker_operation": "hvcc-prefix-",
  "oracle": "hvcc-prefix",
  "contract": [
    "Inspect the fixed 23-byte HEVCDecoderConfigurationRecord prefix regardless of configuration version, reserved bits or opaque tail.",
    "Fold kind 3 with the accessor index and value in order: version, profile space, tier, profile IDC, compatibility flags, 48 constraint bits, level, spatial segmentation, parallelism, chroma format, luma and chroma depth minus eight, average frame rate, constant frame rate, temporal layers, nesting, length size minus one, array count and syntax issues. Fold kind 8 on truncation."
  ],
  "required_profiles": [
    "authored",
    "packet-framing"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
