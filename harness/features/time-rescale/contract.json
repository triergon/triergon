{
  "schema": 1,
  "id": "time-rescale",
  "gate": "required",
  "operation": "time-rescale",
  "candidate": "codec-views-worker",
  "worker_operation": "rescale-",
  "runner": "cargo xtask report",
  "reference": "ffmpeg-codec-views-native",
  "contract": [
    "Rescale the same signed ticks between positive rational time bases with numerator and denominator at most INT_MAX. Separate cases call TimeBase::rescale or construct and reuse TickScale. FFmpeg calls av_rescale_q_rnd on both paths.",
    "In order, compare toward zero, away from zero, floor, ceil and nearest with ties away, against AV_ROUND_ZERO, AV_ROUND_INF, AV_ROUND_DOWN, AV_ROUND_UP and AV_ROUND_NEAR_INF. Fold kind 3 with signed input ticks, mode index and signed result; kind 8 with signed ticks and mode index for overflow. FFmpeg exposes INT64_MIN as its overflow sentinel.",
    "Decode the little-endian signed input ticks before the operation. The independent core-time oracle covers larger bases and ties-to-even conversion."
  ],
  "required_profiles": [
    "clocks",
    "seed",
    "edge"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "iterations": 50,
  "minimum_pairs": 30,
  "confidence": 0.95,
