  "open_deviations": [
    {
      "reading": "The strict big5 profile decodes Big5 as the Encoding Standard does (a profile choice: the reference's C library converts with its own Big5 charmap)",
      "clause": "WHATWG Encoding Standard, Big5 decoder and index-big5: lead bytes 81 to FE, the Hong Kong supplement with its plane 2 characters, the codes 8862, 8864, 88A3 and 88A5 as two code points each, and no single byte beyond ASCII.",
      "candidate": "Refuses byte 80; maps 8740 to U+43F0, 8862 to U+00CA U+0304, C6A1 to U+2460 and F9FE to U+FFED.",
      "reference": "glibc 2.39 iconv decodes 80 as U+0080, refuses 8740 and 8862, and maps C6A1 to U+F6B1 and F9FE to U+2593.",
      "compat": "triergon_subtitles::compat::charset::receiver_charset, whose big5, cp950 and euc-kr profiles convert as the reference build's glibc iconv does",
      "cases": [
        "big5-bytes",
        "big5-pairs",
        "big5-1024",
        "big5-8192",
        "big5-65536"
      ]
    },
    {
      "reading": "The strict windows-950 profile converts code page 950 as Windows does (a profile choice: the reference's C library converts cp950 with its Big5 charmap)",
      "clause": "Microsoft CP950.TXT 2.01 lists the code page's assigned characters; Windows converts the four user-defined areas FA40 to FEFE, 8E40 to A0FE, 8140 to 8DFE and C6A1 to C8FE to U+E000 to U+F848, and the single bytes 80 and FF to U+0080 and U+F8F8.",
      "candidate": "Maps FF to U+F8F8 and every user-defined pair to private use, FA40 to U+E000.",
      "reference": "glibc 2.39 iconv converts CP950 as BIG5: of the user-defined areas it maps C6A1 to C8FE only, and it refuses FF and pairs such as FA40.",
      "compat": "triergon_subtitles::compat::charset::receiver_charset, whose big5, cp950 and euc-kr profiles convert as the reference build's glibc iconv does",
      "cases": [
        "cp950-bytes",
        "cp950-pairs"
      ]
    },
    {
      "reading": "The strict euc-kr profile refuses bytes 80 to 9F (a profile choice)",
      "clause": "EUC-KR (RFC 1557, KS X 2901) codes ASCII and KS X 1001 in A1 to FE; ISO/IEC 2022 and ISO/IEC 4873 let an EUC carry C1 controls in 80 to 9F, which glibc decodes, while the strict profile and the WHATWG decoder leave them undefined.",
      "candidate": "Refuses every byte 80 to 9F, alone or in a pair.",
      "reference": "glibc 2.39 iconv decodes them as the C1 controls U+0080 to U+009F.",
      "compat": "triergon_subtitles::compat::charset::receiver_charset, whose big5, cp950 and euc-kr profiles convert as the reference build's glibc iconv does",
      "cases": [
        "euc-kr-bytes",
        "euc-kr-pairs"
      ]
    },
    {
      "reading": "An unmapped CP949 pair is refused at the start of the pair",
      "clause": "POSIX iconv(): on an invalid input sequence the input position points to the beginning of that sequence; Microsoft CP949.TXT 2.01 has no A2E8.",
      "candidate": "Refuses A2E8 at byte 0.",
      "reference": "Refuses A2E8 at byte 2.",
      "cases": [
        "cp949-pairs"
      ]
    }
  ]
