    {
      "reading": "Big5 uses the historical Unicode mapping and refuses unmapped positions",
      "clause": "Unicode historical BIG5.TXT Table 2.0, kept in crates/subtitles/tests/multibyte-mapping-data, entries 80, A145, A15A and C6A1",
      "candidate": "refuses 80 and A15A, maps A145 to U+2022 and C6A1 to U+30FE",
      "reference": "accepts 80 as U+0080 and A15A as U+2574, maps A145 to U+2027 and C6A1 to U+F6B1",
