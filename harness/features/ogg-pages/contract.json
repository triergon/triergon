{
  "schema": 1,
  "id": "ogg-pages",
  "gate": "required",
  "operation": "ogg-pages",
  "candidate": "codec-views-worker",
  "worker_operation": "ogg-pages-",
  "contract": [
    "Read every original Ogg page from its capture pattern. Rebuild the page with its original flags, granule, serial, sequence, lacing and body. Independently walk the same source bytes using the RFC 3533 section 6 page layout and polynomial CRC.",
    "For each page fold kind 3 with version, flags, signed granule as a uint64 word, serial, sequence, CRC word, CRC validity, lacing count and lacing bytes. Fold kind 1 with complete page length and the written bytes. A truncated or malformed header or body folds kind 8.",
    "Compare the stored pages of the bitexact remux inputs and the original Skeleton input. Wire controls include all flag combinations, a full 255-segment page, empty packets and missing granules."
  ],
  "required_profiles": [
    "reference-refusal",
    "remux",
    "wire"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "iterations": 20,
  "minimum_pairs": 30,
  "confidence": 0.95,
  "runner": "cargo xtask report",
  "reference": "ffmpeg-codec-views-native",
