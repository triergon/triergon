{
  "schema": 1,
  "id": "bridge-access-units",
  "gate": "required",
  "operation": "bridge-access-units",
  "candidate": "playback-views-worker",
  "worker_operation": "access-units-",
  "reference": "ffmpeg-bridge-views-native",
  "runner": "cargo xtask report",
  "contract": [
    "Frame the selected Matroska or ISO BMFF track through AccessUnits and its step-driven packet job. FFmpeg 9.0.2 uses h264_mp4toannexb, hevc_mp4toannexb or the ADTS muxer. Unframed AV1 access units retain the container payload.",
    "Record stream ordinal, optional PTS and DTS in nanoseconds, key flag, initial or changed configuration flag, length and all bytes for each output. ISO BMFF times are the sample-table times with edits disabled. Matroska carries no source DTS.",
    "Legacy AAC packets are raw in Matroska. Cases with a declared record pass the fixture's 48 kHz stereo ASC to AccessUnits::with_record. The companion cases exercise track-only initialization.",
    "Preload both sources outside the operation. Open, read and finish both pipelines within the operation, folding a clean terminal or an input and framing refusal."
  ],
  "required_profiles": [
    "mkv-aac",
    "mkv-aac-declared",
    "mkv-av1",
    "mkv-h264",
    "mkv-hevc",
    "mp4-aac",
    "mp4-av1",
    "mp4-h264",
    "mp4-hevc"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "iterations": 50,
