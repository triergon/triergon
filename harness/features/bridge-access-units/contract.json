    {
      "reading": "Matroska AAC framing keeps fractional-tick CodecDelay",
      "clause": "RFC 9559 sections 5.1.4.1.25 and 11.2 subtract nanosecond CodecDelay from the exact Block presentation timestamp.",
      "candidate": "Uses exact nanosecond CodecDelay subtraction for AAC access-unit PTS, including -21333333 and -23219955 ns.",
      "reference": "Reports -21000000 and -23000000 ns for the corresponding AAC frames, with the same framed payload.",
      "compat": "compat::matroska::demux_packet_clocks for consumers using the reference DTS fill-in and duration quantization.",
      "cases": [
        "mkv-feed-audio-mixed-discovery-0-aac",
        "mkv-feed-audio-mixed-discovery-1-aac",
        "mkv-feed-three-tracks-1-aac",
        "mkv-feed-three-tracks-2-aac"
      ]
    },
    {
