    {
      "reading": "Seven declared channels have no AAC-LC channel configuration of the legacy mapping",
      "clause": "ISO/IEC 14496-3 Table 1.19: channelConfiguration 7 designates eight channels; RFC 9559 section 5.1.4.1.29.3 gives this track seven channels, and Matroska codec mappings draft 21 section 3.4.6 gives A_AAC/MPEG4/LC no initialization.",
      "candidate": "Refuses before framing any access unit with Unsupported (legacy Matroska AAC channel layout).",
      "reference": "Derives an ASC with channel configuration 7 (eight channels) for the seven-channel track and emits eight ADTS frames.",
      "cases": [
        "mkv-feed-aac-mpeg4-lc-ambiguous-layout-0-aac"
      ]
    },
    {
      "reading": "Matroska AAC framing subtracts CodecDelay exactly",
      "clause": "RFC 9559 section 5.1.4.1.25: CodecDelay is in nanoseconds and MUST be subtracted from each frame timestamp; section 11.2 gives the exact Block presentation time.",
      "candidate": "Frames AAC access units at the exact PTS, including -21333333 and -23219955 ns.",
