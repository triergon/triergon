  "runner": "cargo xtask report",
  "reference": "ffmpeg-codec-views-native",
  "contract": [
    "Repeatedly call adts::find_frame from the end of the previous hit. Compare with the AAC av_parser_parse2 output including the drained packet. A reference packet without an ADTS syncword and complete fixed and variable header contributes no frame.",
    "Fold kind 1 with source offset, declared frame length, profile, sample-rate index, channel configuration, actual byte count, and exact received packet bytes. The parser publishes the source offset in frame_offset. A cut-short final frame retains its original length field and received extent."
  ],
  "required_profiles": [
    "authored",
    "fate",
    "reader-aac",
    "search"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "iterations": 50,
  "minimum_pairs": 30,
