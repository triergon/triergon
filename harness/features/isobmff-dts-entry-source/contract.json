{
  "schema": 1,
  "id": "isobmff-dts-entry-source",
  "gate": "required",
  "operation": "ddts",
  "candidate": "isobmff-views-worker",
  "worker_operation": "ddts-",
  "oracle": "ddts",
  "contract": [
    "Compare every audio entry's DTS core admission with an independent ISO box and descriptor reader. Apply the fixed core-entry subset of ETSI TS 102 114 Annex E and the DTS MPEG-4 object-type and QuickTime v1 rules.",
    "Fold track count, and for each description track index, description ordinal, verdict, the integral sample-entry rate, the declared DTS clock frequency and samples per access unit. An absent clock has both fields zero."
  ],
  "required_profiles": [
    "dts-entry",
    "controls",
    "mismatched"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
