        "matrix-extension-7"
      ]
    },
    {
      "reading": "Bytes that are not a frame where one is due",
      "clause": "ETSI TS 102 114 V1.6.1 clauses 5.3 and 5.4.2: a frame begins with SYNC 0x7FFE8001 and spans FSIZE + 1 bytes, so bytes without SYNC belong to no frame",
      "candidate": "returns the frames before those bytes, then refuses with Invalid where a frame is due and SYNC is absent; the aligned reader documents that it does not search",
      "reference": "the dca parser returns the bytes as a packet of their own or appends them to the previous frame's packet (112 and 100 bytes for 96-byte frames), then resumes at the next SYNC",
      "cases": [
        "matrix-bad-sync", "good-then-invalid", "interframe-garbage"
