{
  "schema": 1,
  "id": "dts-core-frames",
  "gate": "required",
  "operation": "dts-core-frames",
  "candidate": "framing-views-worker",
  "worker_operation": "dts-core-",
  "contract": [
    "Drive DtsCoreFrameReader and the public dca parser with the window in argument one, and apply the same core packet byte limit in argument two. The parser is opened at offset zero with default flags and drained at EOF.",
    "Fold kind 1 with source offset, packet byte count, the declared sizes from DtsHeaderInspector and inspect_header_bits, probe_frame_extent size, source sample rate and coded duration, and the packet bytes. The reference uses dca_core output length for the three sizes and the parser clock for rate and duration. Core mode compares the core bytes from dca_core in both rows while retaining the parser’s physical access-unit offset, so following extension substreams do not count toward the core extent.",
    "Fold kind 1 with core byte count and all core bytes, from the bounded core prefix on the candidate and the dca_core output on the reference. Fold kind 7 at clean EOF or kind 8 at refusal, retaining any frames already emitted.",
    "The decoded mode adds one kind 3 row before the first packet. It compares core channel count and arrangement, nominal bit rate and absent raw depth with the layout and codec context of the first frame the reference decodes with its core_only option, so the extensions inside a core frame add no channels.",
    "Input loading and argument parsing are outside the operation. Reader or parser setup, both packet folds, the reference filter, and teardown are inside. The decoded cases are parity only."
  ],
  "required_profiles": [
    "matrix",
    "authored",
    "boundaries",
    "fate",
    "decoded"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "iterations": 50,
  "minimum_pairs": 30,
  "confidence": 0.95,
  "reference": "ffmpeg-framing-views-native",
  "runner": "cargo xtask report",
  "open_deviations": [
    {
      "reading": "Header codes the specification rules out",
      "clause": "ETSI TS 102 114 V1.6.1 clause 5.4.2: SFREQ 0, 4, 5, 9, 10, 14 and 15 (Table 5-5), RATE other than 0 to 24 and 29 (Table 5-7), LFF 3 (Table 5-14) and PCMR 4 and 7 (Table 5-17) are invalid, FSIZE 0 to 94 and NBLKS 0 to 4 are invalid, a normal frame has SHORT 31 (Table 5-3) and NBLKS 7, 15, 31, 63 or 127, and FixedBit is 0",
      "candidate": "refuses the stream with Invalid at the frame whose header breaks the clause",
      "reference": "the dca parser returns the frame's bytes as a packet, with no clock, with the 48000 Hz and 512 samples it reads despite a RATE code, or with 96000 or 192000 Hz for SFREQ 14 and 15",
      "cases": [
        "matrix-bitrate-25", "matrix-bitrate-26", "matrix-bitrate-27", "matrix-bitrate-28",
        "matrix-bitrate-30", "matrix-bitrate-31", "matrix-sampling-code-0", "matrix-sampling-code-4",
        "matrix-sampling-code-5", "matrix-sampling-code-9", "matrix-sampling-code-10", "matrix-sampling-code-14",
        "matrix-sampling-code-15", "matrix-size-0", "matrix-size-94", "below-minimum-fsize",
        "matrix-invalid-blocks-0", "matrix-invalid-blocks-4", "matrix-invalid-blocks-5", "matrix-invalid-blocks-6",
        "matrix-normal-short-zero", "matrix-fixed-one", "matrix-lfe-invalid", "matrix-pcm-4",
        "matrix-pcm-7"
      ]
    },
    {
      "reading": "Encoder revisions and extension codes the present document does not define",
      "clause": "ETSI TS 102 114 V1.6.1 clause 5.4.2: VERNUM 8 to 15 are future revisions incompatible with the present document, which a decoder not designed for them mutes (Table 5-16), and EXT_AUDIO_ID 1, 3, 4, 5 and 7 are reserved (Table 5-11)",
      "candidate": "refuses the stream with Unsupported at that frame",
      "reference": "the dca parser returns the frame's bytes as a packet with the 48000 Hz, 512-sample clock its header codes",
      "compat": "a consumer that wants such frames passed on as opaque core frames would use a compat::dts policy that frames them (not built)",
      "cases": [
        "matrix-version-8", "matrix-version-9", "matrix-version-10", "matrix-version-11",
