  "schema": 1,
  "id": "ass-render-settings",
  "runner": "cargo xtask report",
  "operation": "ass-render",
  "candidate": "ass-worker",
  "worker_operation": "ass-render-",
  "reference": "libass-ass-native",
  "measurement_reference": "libass-player-native",
  "gate": "required",
  "compare_order": 6,
  "contract": [
    "render the authored ASS scripts and Matroska packet stream at their fixture times, with a 1920x1080 frame over 1280x720 storage and the font attachments, fallback, hinting, bitmap engine and cache configuration of ass-render",
    "render the facade example orientation script at 500 and 1000 ms with a 640x360 frame and storage size",
    "after frame and storage size, apply the explicitly supplied settings in this order: margins in top,bottom,left,right order, use-margins, pixel-aspect, font-scale, line-spacing, line-position; omitted settings have the renderer's defaults",
    "fold each frame's time, change code and image count, followed by each image's kind, position, size, colour and alpha rows in render order, with the same background box kind as ass-render; packets count images and bytes count their alpha bytes",
    "parse the fixture envelope and renderer settings and read the attached font files before the operation; the timed span starts at the configured renderer and ends after the last frame fold, with memory covering setup, rendering and teardown as in ass-render",
    "parity uses libass-ass-native with target-dependent conversions flagged; runtime and memory use libass-player-native, linked against the same prepared libass"
  ],
  "required_profiles": [
    "script",
    "stream"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "iterations": 1,
