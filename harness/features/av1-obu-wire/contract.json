  "schema": 1,
  "id": "av1-obu-wire",
  "gate": "required",
  "operation": "av1-obu-wire",
  "candidate": "framing-views-worker",
  "worker_operation": "obu-wire-",
  "oracle": "av1-obu",
  "contract": [
    "Read every IVF temporal unit at the declared input window size. Compare the AV1 wire fields with a whole-buffer AV1 syntax oracle.",
    "Trace kind 3 with unit index, OBU and payload offsets, wire and payload lengths, raw header and extension bytes (256 when absent), LEB128 width and value (zero when absent), syntax issues and external length (zero when absent), then wire length and all wire bytes.",
    "Trace kind 1 with temporal unit index, OBU offset, payload length and payload bytes. Trace kind 7 with unit index and count on clean end or kind 8 with unit index on refusal."
  ],
  "required_profiles": [
    "authored-low-overhead",
    "authored-single",
    "encoded-authored",
    "fate"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "iterations": 1,
  "minimum_pairs": 30,
  "confidence": 0.95,
