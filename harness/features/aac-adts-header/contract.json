  "oracle": "adts",
  "contract": [
    "Read the seven-byte ADTS prefix and parse each available declared frame. Compare the source fields with a whole-buffer ISO/IEC 14496-3 syntax oracle.",
    "Trace kind 3 with offset, all fixed and variable header fields in wire order, selected wire issues, derived single-block header length, rate and channels (zero when absent), prefix length and the exact prefix bytes.",
    "Trace kind 1 with frame offset, CRC presence and 16-bit word (zero when absent), payload length and every payload byte. Trace kind 7 with the frame count on clean end or kind 8 with the offset on refusal."
  ],
  "required_profiles": [
    "authored",
    "fate"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
