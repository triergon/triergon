{
  "schema": 1,
  "id": "elementary-metadata",
  "gate": "required",
  "operation": "elementary-metadata",
  "candidate": "codec-views-worker",
  "worker_operation": "elementary-metadata-",
  "contract": [
    "Force the same elementary format on both sides over a preloaded seekable source. Read the first audio packet and fold codec and FLAC STREAMINFO, sample rate and channels where the reference supplies them, declared duration in samples, and start trim in samples. AAC rate and channels and E-AC-3 channels are compared by the wire oracle.",
    "For MPEG audio, read through the footer in the candidate to include ID3v1 and APEv2 tags. Compare the sorted dictionary projection with the reference format dictionary. The projection includes the shared title, artist, album_artist, album, date, track, disc, composer, copyright, encoded_by, publisher, encoder and comment keys. Decode ID3v2 text frames by their encoding and ID3v1 fields as Latin-1. Compare the FLAC comment through the same key set.",
    "The separate wire comparison covers physical metadata and tag layout, SEEKTABLE points that lack a public reference index view, first frame headers, Xing/Info fields and the LAME view. The reference's skip-sample side data is a decoder trim and is compared to candidate packet trim."
  ],
  "required_profiles": [
    "aac",
    "ac3",
    "eac3",
    "flac",
    "mp3"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu",
    "thumbv7neon-unknown-linux-gnueabihf"
  ],
  "iterations": 20,
  "minimum_pairs": 30,
  "confidence": 0.95,
  "runner": "cargo xtask report",
  "reference": "ffmpeg-codec-views-native",
