  {
   "reading": "Seek to the FLAC frame containing the target",
   "clause": "RFC 9639 sections 8.5, 8.5.1 and 9.1.5 define seek points and frame or sample numbering. The elementary reader selects the frame containing the target.",
   "candidate": "returns the containing frame and its complete suffix",
   "reference": "starts on the following frame and returns one fewer packet",
   "cases": ["flac_default.flac@middle", "flac_small_blocks.flac@middle", "flac-extra@middle"],
   "expected_by_case": {
