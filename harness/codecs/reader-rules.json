{
 "schema": "triergon.codecs.reader-rules.v1",
 "frozen_utc": "2026-11-08T07:35:00Z",
 "reference": "ffprobe of FFmpeg 9.0.2, the decode profile of cargo xtask prepare-ffmpeg (.research/reference-decode/install/bin/ffprobe), -show_packets with the demuxer forced",
 "candidate": "codec-worker packets FORMAT FILE: every packet triergon_ogg::BlockingReader or the triergon_elementary reader of FORMAT emits, as the reader reports it",
 "formats": {
  "ogg": {
   "compare": [
    "size",
    "pts",
    "dts",
    "duration",
    "trim_start",
    "trim_end"
   ],
   "streams": "position-in-link",
   "reference_duration_excludes_discard_padding": true
  },
  "flac": {
   "compare": [
    "size",
    "position",
    "pts",
    "dts",
    "duration",
    "trim_start",
    "trim_end"
   ],
   "streams": "first-audio"
  },
  "mp3": {
   "compare": [
    "size",
    "position",
    "pts",
    "dts",
    "duration",
    "trim_start",
    "trim_end"
   ],
   "streams": "first-audio"
  },
  "aac": {
   "compare": [
    "size",
    "position",
    "pts",
    "dts",
    "duration",
    "trim_start",
    "trim_end"
   ],
   "streams": "first-audio"
  },
  "ac3": {
   "compare": [
    "size",
    "position",
    "pts",
    "dts",
    "duration",
    "trim_start",
    "trim_end"
   ],
   "streams": "first-audio"
  },
  "eac3": {
   "compare": [
    "size",
    "position",
    "pts",
    "dts",
    "duration",
    "trim_start",
    "trim_end"
   ],
   "streams": "first-audio"
  }
 },
 "rules": [
  {
   "id": "forced-demuxer",
   "scope": "every case",
   "rule": "both sides read the file with the format of its manifest lane: ffprobe -f ogg|flac|mp3|aac|ac3|eac3, codec-worker the same reader",
   "reason": "the comparison is of one reader against one demuxer; probing could pick a different one on either side"
  },
  {
   "id": "ordered-pairing",
   "scope": "every case",
   "rule": "packets are paired in order per stream; packet counts, the set of streams and whether reading ended in an error are compared, and every compared field of every pair",
   "reason": "a reader emits packets in file order; nothing is matched by search or skipped"
  },
  {
   "id": "time-base-projection",
   "scope": "pts, dts and duration",
   "rule": "the reader's ticks are rescaled into the FFmpeg stream time base when every time converts exactly; otherwise each duration is rounded down and the times accumulate from the first packet's time",
   "reason": "FFmpeg times elementary streams in a fixed base (MPEG audio 1/14112000, ADTS 1/28224000, AC-3 1/90000) and, where a frame's sample count does not divide it (AC-3 at 44.1 kHz), its parser rounds each duration down and adds them up"
  },
  {
   "id": "absent-trim-is-zero",
   "scope": "trim_start, trim_end",
   "rule": "an absent trim equals a trim of zero: the reader's Trim::start and Trim::end against the skip_samples and discard_padding of FFmpeg's skip-samples side data",
   "reason": "FFmpeg attaches the side data only to packets it trims and writes both values when it does"
  },
  {
   "id": "ogg-streams-position-in-link",
   "scope": "ogg",
   "rule": "the reader's n-th track of every chain link is FFmpeg's stream n",
   "reason": "FFmpeg's Ogg demuxer replaces a link's streams in place when a chained link starts, where the reader opens new tracks"
  },
  {
   "id": "ogg-duration-excludes-padding",
   "scope": "ogg",
   "rule": "the reader's duration is compared with FFmpeg's duration plus the packet's discard padding",
   "reason": "FFmpeg's Ogg demuxer shortens the last packet's duration by the discard padding it reports; the reader keeps the coded duration and reports the padding as Trim::end, which is compared separately"
  },
  {
   "id": "ogg-position-not-compared",
   "scope": "ogg",
   "rule": "packet positions are not compared",
   "reason": "the reader reports the page that completes a packet and FFmpeg the page it starts on, so the two differ by definition for every packet that spans pages"
  },
  {
   "id": "elementary-first-audio-stream",
   "scope": "flac, mp3, aac, ac3, eac3",
   "rule": "the reader's one track is FFmpeg's first audio stream; packets of other streams are counted in the row (reference_other_packets) and not compared",
   "reason": "FFmpeg turns an ID3v2 picture into an attached-picture video stream; the reader keeps tag bytes as tags, not packets"
  }
 ],
 "dispositions": [
  {
   "id": "vorbis-first-packet",
   "reason": "FFmpeg gives the first Vorbis audio packet the duration it states alone and starts it that long before zero (on every chain link); the reader times it as completing no samples, as the first block's output only primes the overlap"
  },
  {
   "id": "vorbis-short-after-long",
   "reason": "inside a page FFmpeg times each packet back from the granule position with the durations packets state alone; a short block after a long one states a quarter of two short blocks, not its overlap with the long block, so FFmpeg starts that packet (long - short) / 4 samples late and as much shorter; the reader uses the overlap"
  },
  {
   "id": "ogg-last-page-forward",
   "reason": "FFmpeg times the last page forwards from its first packet and reports the excess over the granule position as discard padding, so a last page whose granule position precedes its last packet's start ends in a negative duration that ffprobe prints modulo 2^32; the reader times the page backwards from its granule position with an end trim"
  },
  {
   "id": "ogg-chained-link-start",
   "reason": "FFmpeg continues a chained link where the previous link's last packet ended, without the new link's own start offset; the reader places the link by its start offset (Opus pre-skip)"
  },
  {
   "id": "ogg-lost-page",
   "reason": "the first packet after lost pages takes the granule position of the last page FFmpeg read; the reader times it from its own page's granule position"
  },
  {
   "id": "opus-pre-skip-after-lost-start",
   "reason": "when the first audio page fails its CRC, FFmpeg still reports the Opus pre-skip as skip samples on the first packet it keeps; the reader applies pre-skip to the stream start, which was lost"
  },
  {
   "id": "flac-rate-change-duration",
   "reason": "when the sample rate changes, FFmpeg delivers each FLAC frame's duration rescaled to the first frame's rate (and times later frames by those durations); the reader times every frame at its own rate"
  },
  {
   "id": "flac-768k-no-duration",
   "reason": "FFmpeg delivers FLAC frames at 768 kHz without a duration and the last one without a time; the reader times them from the frame headers"
  },
  {
   "id": "flac-variable-under-fixed-last",
   "reason": "in a stream with varying block sizes under the fixed-blocking flag, FFmpeg times the last frame at the previous frame's end; the reader times it from its frame number"
  },
  {
   "id": "flac-damaged-frame-merge",
   "reason": "FFmpeg merges a damaged FLAC frame with the three after it into one packet without times; the reader ends the damaged frame at the next header its CRC-16 confirms"
  },
  {
   "id": "leading-bytes-packet",
   "reason": "FFmpeg delivers the bytes before the first FLAC or AC-3 frame as a packet; the reader keeps leading tags as tags and skips junk to the first confirmed frame"
  },
  {
   "id": "trailing-id3v1-in-last-packet",
   "reason": "FFmpeg delivers an ID3v1 tag at the end of a FLAC or AC-3 stream as part of the last packet; the reader keeps it as a tag"
  },
  {
   "id": "mpeg-foreign-frame",
   "reason": "FFmpeg accepts an MPEG audio frame of another version or sample rate, or a header in junk that no frame follows; the reader requires the frame after a header to confirm it"
  },
  {
   "id": "mpeg-free-format",
   "reason": "FFmpeg 9.0.2 refuses free-format MPEG audio; the reader delivers its frames"
  },
  {
   "id": "adts-position-after-junk",
   "reason": "FFmpeg reports ADTS packet positions after junk as if the junk were not there; the reader reports each frame's source offset"
  },
  {
   "id": "flac-small-max-blocksize",
   "reason": "FFmpeg refuses to open a FLAC stream whose STREAMINFO declares a maximum block size below 16; that is a decoder decision, so the reader still delivers the frames"
  },
  {
   "id": "flac-metadata-past-end",
   "reason": "a metadata block whose length runs past the end of the file: FFmpeg declares the stream STREAMINFO describes and delivers no packets; the reader refuses the stream as truncated, since no frame can follow the metadata"
  }
 ],
