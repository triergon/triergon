# Subroutine calls. Local subroutine k (biased index k - 107) of 0..19 calls
# k + 1 and then draws `0 10 rlineto`; subroutine 20 draws `50 0 rlineto`. Glyph
# d calls subroutine 20 - d + 1 after `100 100 rmoveto`, nesting d calls deep
# (glyphs 1 to 21), so the box shows how deep calls go and what a call too deep
# does.
local
  -106 callsubr 0 10 rlineto return
end
local
  -105 callsubr 0 10 rlineto return
end
local
  -104 callsubr 0 10 rlineto return
end
local
  -103 callsubr 0 10 rlineto return
end
