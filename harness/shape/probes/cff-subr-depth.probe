  -92 callsubr 0 10 rlineto return
end
local
  -91 callsubr 0 10 rlineto return
end
local
  -90 callsubr 0 10 rlineto return
end
local
  -89 callsubr 0 10 rlineto return
end
local
  -88 callsubr 0 10 rlineto return
end
local
  -87 callsubr 0 10 rlineto return
end
local
  50 0 rlineto return
end
glyph
  endchar
end
glyph # 1 deep
  100 100 rmoveto -87 callsubr endchar
end
