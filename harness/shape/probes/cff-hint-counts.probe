# How odd operand counts of stem operators count toward the hint mask's
# length. Mask bytes are 0x15 (an rmoveto without operands), so a byte read
# as an operator fails the glyph, and a byte too many swallows the first
# byte of the `100 100 rmoveto` after it.
glyph
  endchar
end
glyph # 1: 8 hstems, then vstemhm with 1 operand, one mask byte
  0 1 2 1 4 1 6 1 8 1 10 1 12 1 14 1 hstemhm 5 vstemhm hintmask byte:0x15 100 100 rmoveto 10 20 rlineto endchar
end
glyph # 2: 8 hstems, then vstemhm with 1 operand, two mask bytes
  0 1 2 1 4 1 6 1 8 1 10 1 12 1 14 1 hstemhm 5 vstemhm hintmask bytes:1515 100 100 rmoveto 10 20 rlineto endchar
end
