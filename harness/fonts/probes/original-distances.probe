# With integer pixels per em: MD, GC, WCVTF, MDRP and SSW. Observed: MD[1]
# and MDRP scale font-unit distances by the integer-ppem scale points load at.
# Each glyph's program computes values and writes value i into the y of
# point i of a 32-point contour (SCFS along y), so the dump shows them.
heights 1000 700 1500 12345
head-flags 8
cvt 1000 -999
fpgm
  PUSH 0; FDEF; ENDF
end
glyph advance 400
  contour 0 0, 10 0, 20 0, 30 0, 40 0, 50 0, 60 0, 70 0, 80 0, 90 0, 100 0, 110 0, 120 0, 130 0, 140 0, 150 0, 160 0, 170 0, 180 0, 190 0, 200 0, 210 0, 220 0, 230 0, 240 0, 250 0, 260 0, 270 0, 280 0, 290 0, 300 0, 310 0
  contour 0 0, 300 100, 100 700, -200 50, 1000 999, 3 7, 1500 -1300, 77 1
  contour 0 0, 10 0, 20 0, 30 0, 40 0, 50 0, 60 0, 70 500
  program
    SVTCA[0]
    PUSH 0; PUSH 33 34; MD[1]; SVTCA[0]; SCFS
    PUSH 1; PUSH 34 33; MD[1]; SVTCA[0]; SCFS
    PUSH 2; PUSH 36 38; MD[1]; SVTCA[0]; SCFS
    PUSH 3; PUSH 33 34; MD[0]; SVTCA[0]; SCFS
    PUSH 4; PUSH 0 1000; WCVTF; PUSH 0; RCVT; SVTCA[0]; SCFS
    PUSH 5; PUSH 0 -999; WCVTF; PUSH 0; RCVT; SVTCA[0]; SCFS
    PUSH 6; PUSH 0; RCVT; SVTCA[0]; SCFS
    PUSH 7; PUSH 1; RCVT; SVTCA[0]; SCFS
    PUSH 8; PUSH 40; SRP0; PUSH 47; MDRP[00000]; PUSH 47; GC[0]; SVTCA[0]; SCFS
    PUSH 9; PUSH 300; SSW; PUSH 10000; SSWCI; PUSH 40; SRP0; PUSH 46; MDRP[00000]; PUSH 46; GC[0]; SVTCA[0]; SCFS
    PUSH 10; PUSH 34; GC[1]; SVTCA[0]; SCFS
    PUSH 11; PUSH 36; GC[1]; SVTCA[0]; SCFS
    PUSH 12; PUSH 33; GC[0]; SVTCA[0]; SCFS
    PUSH 13; PUSH 0x2D41 0x2D41; SPVFS; PUSH 33 34; MD[1]; SVTCA[0]; SCFS
    PUSH 14; PUSH 0x2D41 0x2D41; SPVFS; PUSH 34; GC[1]; SVTCA[0]; SCFS
  end
end
