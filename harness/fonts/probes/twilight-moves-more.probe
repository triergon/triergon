# More moves of twilight point 2 along a freedom vector with an x part (from
# point 1 to point 0, projection y), its current x and y and original x and
# y then copied to the y of points 10 to 13: MDRP from glyph rp0 1 after
# point 1 moved to 960 in y, SHP by point 1's move, DELTAP1 by 8 steps, MDAP
# rounding (point 2 placed 20 above point 0), SHZ of the twilight zone by
# point 1's move, and IP between points 0 and 1 after point 1's move.
# Observed: none of them moves the twilight point in x.
heights 16384
maxp twilight 16
fpgm
  PUSH 0; FDEF; ENDF
end
glyph advance 600
  contour 100 200, 300 400, 80 0, 120 0, 160 0, 200 0, 240 0, 280 0, 320 0, 360 0, 400 0, 440 0, 480 0, 520 0, 560 0, 600 0
  program
    SVTCA[0]; PUSH 0; SRP0; PUSH 0; SZP1; PUSH 2 0; MSIRP[0]; PUSH 1; SZP1; SVTCA[0]; PUSH 1 960; SCFS; SPVTCA[0]; PUSH 0 1; SFVTL[0]; PUSH 1; SRP0; PUSH 0; SZP1; PUSH 2; MDRP[00000]; PUSH 1; SZP1; PUSH 0; SZP2; SVTCA[1]; PUSH 10 2; GC[0]; PUSH 1; SZP2; SVTCA[0]; SCFS; PUSH 0; SZP2; SVTCA[0]; PUSH 11 2; GC[0]; PUSH 1; SZP2; SVTCA[0]; SCFS; PUSH 0; SZP2; SVTCA[1]; PUSH 12 2; GC[1]; PUSH 1; SZP2; SVTCA[0]; SCFS; PUSH 0; SZP2; SVTCA[0]; PUSH 13 2; GC[1]; PUSH 1; SZP2; SVTCA[0]; SCFS
  end
end
