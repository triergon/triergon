# Twilight point 2 moved along a freedom vector with an x part (from point
# 1 to point 0, the projection vector y unless said), then its current x and
# y and original x and y copied to the y of points 10 to 13: MDRP from a
# glyph rp0 and from a twilight one, MIRP from a twilight rp0 and from a
# glyph one, SHPIX, MSIRP from a twilight rp0 and from a glyph one, ALIGNRP,
# MDAP, SCFS, MIRP along y, and MIRP with freedom x and projection along
# points 0 to 1. Points 0 and 1 are at 100 200 and 300 400; a placed twilight
# point starts at a glyph point's position, by MSIRP of distance 0.
# Observed: no instruction but MSIRP moves the twilight point in x; SCFS
# and MSIRP move its original position with it.
heights 16384
maxp twilight 16
cvt 300
fpgm
  PUSH 0; FDEF; ENDF
end
glyph advance 600
  contour 100 200, 300 400, 80 0, 120 0, 160 0, 200 0, 240 0, 280 0, 320 0, 360 0, 400 0, 440 0, 480 0, 520 0, 560 0, 600 0
  program
    SVTCA[0]; PUSH 0; SRP0; PUSH 0; SZP1; PUSH 2 0; MSIRP[0]; PUSH 1; SZP1; SPVTCA[0]; PUSH 0 1; SFVTL[0]; PUSH 1; SRP0; PUSH 0; SZP1; PUSH 2; MDRP[00000]; PUSH 1; SZP1; PUSH 0; SZP2; SVTCA[1]; PUSH 10 2; GC[0]; PUSH 1; SZP2; SVTCA[0]; SCFS; PUSH 0; SZP2; SVTCA[0]; PUSH 11 2; GC[0]; PUSH 1; SZP2; SVTCA[0]; SCFS; PUSH 0; SZP2; SVTCA[1]; PUSH 12 2; GC[1]; PUSH 1; SZP2; SVTCA[0]; SCFS; PUSH 0; SZP2; SVTCA[0]; PUSH 13 2; GC[1]; PUSH 1; SZP2; SVTCA[0]; SCFS
  end
end
