  contour 105 3, 105 1403, 903 1403 off, 903 3
  program
    SVTCA[0]; PUSH 1 64; SHPIX
  end
end
glyph advance 1100
  contour 105 3, 105 1403, 903 1403 off, 903 3
  program
    SVTCA[0]; PUSH 1; MDAP[0]; PUSH 1 64; SHPIX
  end
end
glyph advance 1100
  contour 105 3, 105 1403, 903 1403 off, 903 3
  program
    SVTCA[1]; PUSH 1; MDAP[0]; SVTCA[0]; PUSH 1 64; SHPIX
