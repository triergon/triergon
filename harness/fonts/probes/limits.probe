# Storage, control values, twilight points and functions at and past maxp's
# limits (storage 8, twilight 4, functions 4). Observed: storage and
# control values hold exactly what maxp and the table give, the twilight
# zone four points more; calling an undefined function ends the program.
heights 16384
cvt 30 -501
maxp storage 8 twilight 4 functions 4
fpgm
  PUSH 0; FDEF; ENDF
end
glyph advance 400
  contour 0 0, 10 0, 20 0, 30 0, 40 0, 50 0, 60 0, 70 0, 80 0, 90 0, 100 0, 110 0, 120 0, 130 0, 140 0, 150 0, 160 0, 170 0, 180 0, 190 0, 200 0, 210 0, 220 0, 230 0, 240 0, 250 0, 260 0, 270 0, 280 0, 290 0, 300 0, 310 0
  contour 0 0, 300 100, 100 700, -200 50, 1000 999, 3 7, 1500 -1300, 77 1
  contour 0 0, 10 0, 20 0, 30 0, 40 0, 50 0, 60 0, 70 500
  program
    PUSH 0; PUSH 5 77; WS; PUSH 5; RS; SVTCA[0]; SCFS
    PUSH 1; PUSH 8 77; WS; PUSH 8; RS; SVTCA[0]; SCFS
    PUSH 2; PUSH 9 77; WS; PUSH 9; RS; SVTCA[0]; SCFS
    PUSH 3; PUSH 100 77; WS; PUSH 100; RS; SVTCA[0]; SCFS
    PUSH 4; PUSH 2 640; WCVTP; PUSH 2; RCVT; SVTCA[0]; SCFS
    PUSH 5; PUSH 3 640; WCVTP; PUSH 3; RCVT; SVTCA[0]; SCFS
    PUSH 6; PUSH 0; SZP0; SVTCA[0]; PUSH 3 0; MIAP[0]; PUSH 0; SZP2; PUSH 3; GC[0]; PUSH 1; SZP0; PUSH 1; SZP2; SVTCA[0]; SCFS
    PUSH 7; PUSH 0; SZP0; SVTCA[0]; PUSH 4 0; MIAP[0]; PUSH 0; SZP2; PUSH 4; GC[0]; PUSH 1; SZP0; PUSH 1; SZP2; SVTCA[0]; SCFS
    PUSH 8; PUSH 0; SZP0; SVTCA[0]; PUSH 5 0; MIAP[0]; PUSH 0; SZP2; PUSH 5; GC[0]; PUSH 1; SZP0; PUSH 1; SZP2; SVTCA[0]; SCFS
    PUSH 9; PUSH 3; CALL; PUSH 66; SVTCA[0]; SCFS
    PUSH 10; PUSH 4; CALL; PUSH 66; SVTCA[0]; SCFS
  end
end
