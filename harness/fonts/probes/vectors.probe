# Projection vectors set to lines between points and from the stack, read
# back with GPV. Observed: SPVTL's line runs from the second point popped to
# the first, [1] turns it a quarter counter-clockwise, a line of zero length
# gives the x axis; SPVFS normalizes, a zero vector leaves the vector as it
# was.
# Each glyph's program computes values and writes value i into the y of
# point i of a 32-point contour (SCFS along y), so the dump shows them.
heights 16384 1000
fpgm
  PUSH 0; FDEF; ENDF
end
glyph advance 400
  contour 0 0, 10 0, 20 0, 30 0, 40 0, 50 0, 60 0, 70 0, 80 0, 90 0, 100 0, 110 0, 120 0, 130 0, 140 0, 150 0, 160 0, 170 0, 180 0, 190 0, 200 0, 210 0, 220 0, 230 0, 240 0, 250 0, 260 0, 270 0, 280 0, 290 0, 300 0, 310 0
  contour 0 0, 300 100, 100 700, -200 50, 1000 999, 3 7, 1500 -1300, 77 1
  program
    PUSH 0; PUSH 32 33; SPVTL[0]; GPV; POP; SVTCA[0]; SCFS
    PUSH 1; PUSH 32 33; SPVTL[0]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 2; PUSH 32 33; SPVTL[1]; GPV; POP; SVTCA[0]; SCFS
    PUSH 3; PUSH 32 33; SPVTL[1]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 4; PUSH 33 32; SPVTL[0]; GPV; POP; SVTCA[0]; SCFS
    PUSH 5; PUSH 33 32; SPVTL[0]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 6; PUSH 33 32; SPVTL[1]; GPV; POP; SVTCA[0]; SCFS
    PUSH 7; PUSH 33 32; SPVTL[1]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 8; PUSH 32 34; SPVTL[0]; GPV; POP; SVTCA[0]; SCFS
    PUSH 9; PUSH 32 34; SPVTL[0]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 10; PUSH 32 34; SPVTL[1]; GPV; POP; SVTCA[0]; SCFS
    PUSH 11; PUSH 32 34; SPVTL[1]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 12; PUSH 32 35; SPVTL[0]; GPV; POP; SVTCA[0]; SCFS
    PUSH 13; PUSH 32 35; SPVTL[0]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 14; PUSH 32 35; SPVTL[1]; GPV; POP; SVTCA[0]; SCFS
    PUSH 15; PUSH 32 35; SPVTL[1]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 16; PUSH 32 36; SPVTL[0]; GPV; POP; SVTCA[0]; SCFS
    PUSH 17; PUSH 32 36; SPVTL[0]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 18; PUSH 32 36; SPVTL[1]; GPV; POP; SVTCA[0]; SCFS
    PUSH 19; PUSH 32 36; SPVTL[1]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 20; PUSH 32 37; SPVTL[0]; GPV; POP; SVTCA[0]; SCFS
    PUSH 21; PUSH 32 37; SPVTL[0]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 22; PUSH 32 37; SPVTL[1]; GPV; POP; SVTCA[0]; SCFS
    PUSH 23; PUSH 32 37; SPVTL[1]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 24; PUSH 32 38; SPVTL[0]; GPV; POP; SVTCA[0]; SCFS
    PUSH 25; PUSH 32 38; SPVTL[0]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 26; PUSH 32 38; SPVTL[1]; GPV; POP; SVTCA[0]; SCFS
    PUSH 27; PUSH 32 38; SPVTL[1]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 28; PUSH 35 36; SPVTL[0]; GPV; POP; SVTCA[0]; SCFS
    PUSH 29; PUSH 35 36; SPVTL[0]; GPV; SWAP; POP; SVTCA[0]; SCFS
    PUSH 30; PUSH 35 36; SPVTL[1]; GPV; POP; SVTCA[0]; SCFS
    PUSH 31; PUSH 35 36; SPVTL[1]; GPV; SWAP; POP; SVTCA[0]; SCFS
  end
end
glyph advance 400
  contour 0 0, 10 0, 20 0, 30 0, 40 0, 50 0, 60 0, 70 0, 80 0, 90 0, 100 0, 110 0, 120 0, 130 0, 140 0, 150 0, 160 0, 170 0, 180 0, 190 0, 200 0, 210 0, 220 0, 230 0, 240 0, 250 0, 260 0, 270 0, 280 0, 290 0, 300 0, 310 0
  contour 0 0, 300 100, 100 700, -200 50, 1000 999, 3 7, 1500 -1300, 77 1
  program
    PUSH 0; PUSH 32 32; SPVTL[0]; GPV; POP; SVTCA[0]; SCFS
    PUSH 1; PUSH 32 32; SPVTL[0]; GPV; SWAP; POP; SVTCA[0]; SCFS
