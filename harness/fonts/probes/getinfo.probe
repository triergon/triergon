# GETINFO for each selector bit. Observed: version 40, ClearType (bit 13),
# sub-pixel positioning (bit 17) and gray rendering (bit 19), symmetric
# rendering (bit 18) above 20 pixels per em in a face without gasp; nothing
# else.
# Each glyph's program computes values and writes value i into the y of
# point i of a 32-point contour (SCFS along y), so the dump shows them.
heights 16384 2000 1344 1280 1000 640
fpgm
  PUSH 0; FDEF; ENDF
end
glyph advance 400
  contour 0 0, 10 0, 20 0, 30 0, 40 0, 50 0, 60 0, 70 0, 80 0, 90 0, 100 0, 110 0, 120 0, 130 0, 140 0, 150 0, 160 0, 170 0, 180 0, 190 0, 200 0, 210 0, 220 0, 230 0, 240 0, 250 0, 260 0, 270 0, 280 0, 290 0, 300 0, 310 0
  contour 0 0, 300 100, 100 700, -200 50, 1000 999, 3 7, 1500 -1300, 77 1
  contour 0 0, 10 0, 20 0, 30 0, 40 0, 50 0, 60 0, 70 500
  program
    PUSH 0; PUSH 1; GETINFO; SVTCA[0]; SCFS
    PUSH 1; PUSH 2; GETINFO; SVTCA[0]; SCFS
    PUSH 2; PUSH 4; GETINFO; SVTCA[0]; SCFS
    PUSH 3; PUSH 8; GETINFO; SVTCA[0]; SCFS
    PUSH 4; PUSH 16; GETINFO; SVTCA[0]; SCFS
    PUSH 5; PUSH 32; GETINFO; SVTCA[0]; SCFS
    PUSH 6; PUSH 64; GETINFO; SVTCA[0]; SCFS
    PUSH 7; PUSH 128; GETINFO; SVTCA[0]; SCFS
    PUSH 8; PUSH 256; GETINFO; SVTCA[0]; SCFS
    PUSH 9; PUSH 512; GETINFO; SVTCA[0]; SCFS
    PUSH 10; PUSH 1024; GETINFO; SVTCA[0]; SCFS
    PUSH 11; PUSH 2048; GETINFO; SVTCA[0]; SCFS
    PUSH 12; PUSH 4096; GETINFO; SVTCA[0]; SCFS
    PUSH 13; PUSH 8192; GETINFO; SVTCA[0]; SCFS
    PUSH 14; PUSH 16383; GETINFO; SVTCA[0]; SCFS
    PUSH 15; PUSH 3; GETINFO; SVTCA[0]; SCFS
    PUSH 16; PUSH 33; GETINFO; SVTCA[0]; SCFS
    PUSH 17; PUSH 96; GETINFO; SVTCA[0]; SCFS
    PUSH 18; PUSH 32767; GETINFO; SVTCA[0]; SCFS
    PUSH 19; PUSH 0; GETINFO; SVTCA[0]; SCFS
    PUSH 20; PUSH 192; GETINFO; SVTCA[0]; SCFS
    PUSH 21; PUSH 127; GETINFO; SVTCA[0]; SCFS
    PUSH 22; PUSH 65; GETINFO; SVTCA[0]; SCFS
    PUSH 23; PUSH 4096; GETINFO; SVTCA[0]; SCFS
    PUSH 24; PUSH 2048; GETINFO; SVTCA[0]; SCFS
  end
end
