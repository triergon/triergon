  program
    SVTCA[1]; PUSH 0; SRP0; PUSH 0; SZP1; PUSH 4 0; MIRP[00000]; PUSH 1; SZP1; PUSH 0; SZP2; SVTCA[1]; PUSH 10 4; GC[0]; PUSH 1; SZP2; SVTCA[0]; SCFS; PUSH 0; SZP2; SVTCA[0]; PUSH 11 4; GC[0]; PUSH 1; SZP2; SVTCA[0]; SCFS; PUSH 0; SZP2; SVTCA[1]; PUSH 12 4; GC[1]; PUSH 1; SZP2; SVTCA[0]; SCFS; PUSH 0; SZP2; SVTCA[0]; PUSH 13 4; GC[1]; PUSH 1; SZP2; SVTCA[0]; SCFS
