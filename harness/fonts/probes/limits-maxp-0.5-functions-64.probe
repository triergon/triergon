# A version 0.5 maxp and 64 function definitions; the glyph calls the
# last and moves point 1 by what it leaves.
# Observed: the first definition is an error, which fails every hinted
# load.
heights 16384
maxp-version 0.5
fpgm
  PUSH 0; FDEF; PUSH 0; ENDF; PUSH 1; FDEF; PUSH 1; ENDF; PUSH 2; FDEF; PUSH 2; ENDF; PUSH 3; FDEF; PUSH 3; ENDF; PUSH 4; FDEF; PUSH 4; ENDF; PUSH 5; FDEF; PUSH 5; ENDF; PUSH 6; FDEF; PUSH 6; ENDF; PUSH 7; FDEF; PUSH 7; ENDF; PUSH 8; FDEF; PUSH 8; ENDF; PUSH 9; FDEF; PUSH 9; ENDF; PUSH 10; FDEF; PUSH 10; ENDF; PUSH 11; FDEF; PUSH 11; ENDF; PUSH 12; FDEF; PUSH 12; ENDF; PUSH 13; FDEF; PUSH 13; ENDF; PUSH 14; FDEF; PUSH 14; ENDF; PUSH 15; FDEF; PUSH 15; ENDF; PUSH 16; FDEF; PUSH 16; ENDF; PUSH 17; FDEF; PUSH 17; ENDF; PUSH 18; FDEF; PUSH 18; ENDF; PUSH 19; FDEF; PUSH 19; ENDF; PUSH 20; FDEF; PUSH 20; ENDF; PUSH 21; FDEF; PUSH 21; ENDF; PUSH 22; FDEF; PUSH 22; ENDF; PUSH 23; FDEF; PUSH 23; ENDF; PUSH 24; FDEF; PUSH 24; ENDF; PUSH 25; FDEF; PUSH 25; ENDF; PUSH 26; FDEF; PUSH 26; ENDF; PUSH 27; FDEF; PUSH 27; ENDF; PUSH 28; FDEF; PUSH 28; ENDF; PUSH 29; FDEF; PUSH 29; ENDF; PUSH 30; FDEF; PUSH 30; ENDF; PUSH 31; FDEF; PUSH 31; ENDF; PUSH 32; FDEF; PUSH 32; ENDF; PUSH 33; FDEF; PUSH 33; ENDF; PUSH 34; FDEF; PUSH 34; ENDF; PUSH 35; FDEF; PUSH 35; ENDF; PUSH 36; FDEF; PUSH 36; ENDF; PUSH 37; FDEF; PUSH 37; ENDF; PUSH 38; FDEF; PUSH 38; ENDF; PUSH 39; FDEF; PUSH 39; ENDF; PUSH 40; FDEF; PUSH 40; ENDF; PUSH 41; FDEF; PUSH 41; ENDF; PUSH 42; FDEF; PUSH 42; ENDF; PUSH 43; FDEF; PUSH 43; ENDF; PUSH 44; FDEF; PUSH 44; ENDF; PUSH 45; FDEF; PUSH 45; ENDF; PUSH 46; FDEF; PUSH 46; ENDF; PUSH 47; FDEF; PUSH 47; ENDF; PUSH 48; FDEF; PUSH 48; ENDF; PUSH 49; FDEF; PUSH 49; ENDF; PUSH 50; FDEF; PUSH 50; ENDF; PUSH 51; FDEF; PUSH 51; ENDF; PUSH 52; FDEF; PUSH 52; ENDF; PUSH 53; FDEF; PUSH 53; ENDF; PUSH 54; FDEF; PUSH 54; ENDF; PUSH 55; FDEF; PUSH 55; ENDF; PUSH 56; FDEF; PUSH 56; ENDF; PUSH 57; FDEF; PUSH 57; ENDF; PUSH 58; FDEF; PUSH 58; ENDF; PUSH 59; FDEF; PUSH 59; ENDF; PUSH 60; FDEF; PUSH 60; ENDF; PUSH 61; FDEF; PUSH 61; ENDF; PUSH 62; FDEF; PUSH 62; ENDF; PUSH 63; FDEF; PUSH 63; ENDF
