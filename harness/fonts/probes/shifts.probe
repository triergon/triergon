# SHZ, SHC and SHP in y with and without IUP afterwards, and ISECT.
# Observed: SHC touches the points it moves, SHZ does not; IUP shifts a point
# outside the touched pair's range from its current position; ISECT moves
# glyph points in x too, and after IUP in both directions.
heights 16384 1000 700

fpgm
  PUSH 0; FDEF; ENDF
end
glyph advance 600
  contour 100 -12, 100 703, 300 716 off, 497 703, 497 -12, 300 -25 off
  contour 203 97, 397 97, 397 597, 203 597
  program
    SVTCA[0]; PUSH 7; MDAP[1]; PUSH 7; SRP1; PUSH 1; SHZ[1]
  end
end
