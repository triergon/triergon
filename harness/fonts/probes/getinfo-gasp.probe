# GETINFO's symmetric rendering (bit 18) in a face with gasp ranges.
# Observed: it follows the range's symmetric smoothing flag (bit 3).
# Each glyph's program computes values and writes value i into the y of
# point i of a 32-point contour (SCFS along y), so the dump shows them.
heights 896 960 1024 1088 1152 1216 1280 1344 1408 1472 1536 1600 1664
gasp 18 0x0000
gasp 20 0x0008
gasp 22 0x0002
gasp 65535 0x000F
fpgm
  PUSH 0; FDEF; ENDF
end
glyph advance 400
  contour 0 0, 10 0, 20 0, 30 0, 40 0, 50 0, 60 0, 70 0, 80 0, 90 0, 100 0, 110 0, 120 0, 130 0, 140 0, 150 0, 160 0, 170 0, 180 0, 190 0, 200 0, 210 0, 220 0, 230 0, 240 0, 250 0, 260 0, 270 0, 280 0, 290 0, 300 0, 310 0
  contour 0 0, 300 100, 100 700, -200 50, 1000 999, 3 7, 1500 -1300, 77 1
  contour 0 0, 10 0, 20 0, 30 0, 40 0, 50 0, 60 0, 70 500
  program
    PUSH 0; PUSH 2048; GETINFO; SVTCA[0]; SCFS
    PUSH 1; PUSH 1024; GETINFO; SVTCA[0]; SCFS
    PUSH 2; PUSH 4096; GETINFO; SVTCA[0]; SCFS
    PUSH 3; PUSH 32; GETINFO; SVTCA[0]; SCFS
    PUSH 4; PUSH 64; GETINFO; SVTCA[0]; SCFS
    PUSH 5; PUSH 128; GETINFO; SVTCA[0]; SCFS
    PUSH 6; PUSH 256; GETINFO; SVTCA[0]; SCFS
  end
end
