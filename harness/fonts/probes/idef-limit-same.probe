# IDEF of opcode 0x93 twice where maxp allows one: glyphs run 0x93.
# Observed: the second definition replaces the first.
heights 16384
maxp instruction-defs 1
fpgm
  PUSH 147; IDEF; SVTCA[0]; PUSH 2 640; SCFS; ENDF; PUSH 147; IDEF; SVTCA[0]; PUSH 3 640; SCFS; ENDF
end
glyph advance 600
  contour 100 -12, 100 703, 300 716 off, 497 703, 497 -12, 300 -25 off
  contour 203 97, 397 97, 397 597, 203 597
  program
    BYTES 0x93
  end
end
