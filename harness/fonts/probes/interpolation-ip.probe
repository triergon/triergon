# IP in y between moved reference points. Observed: original distances are
# measured in font units and left unscaled, so with reference points sharing
# an original position a point moves to its font-unit distance from rp1.
heights 16384 1000 2000 700 1500

fpgm
  PUSH 0; FDEF; ENDF
end
glyph advance 600
  contour 100 -12, 100 703, 300 716 off, 497 703, 497 -12, 300 -25 off
  contour 203 97, 397 97, 397 597, 203 597
  program
    SVTCA[0]; PUSH 4; MDAP[1]; PUSH 1; MDAP[1]; PUSH 4; SRP1; PUSH 1; SRP2; PUSH 6; IP; PUSH 9; IP; IUP[0]
  end
end
glyph advance 600
  contour 100 -12, 100 703, 300 716 off, 497 703, 497 -12, 300 -25 off
  contour 203 97, 397 97, 397 597, 203 597
  program
    SVTCA[0]; PUSH 4; MDAP[1]; PUSH 1; MDAP[1]; PUSH 4 37; SHPIX; PUSH 4; SRP1; PUSH 1; SRP2; PUSH 3 6 7 8; SLOOP; IP; IUP[0]
  end
end
glyph advance 600
  contour 100 -12, 100 703, 300 716 off, 497 703, 497 -12, 300 -25 off
  contour 203 97, 397 97, 397 597, 203 597
  program
    SVTCA[0]; PUSH 6; MDAP[1]; PUSH 9; MDAP[1]; PUSH 6; SRP1; PUSH 9; SRP2; PUSH 0 3 2; SLOOP; IP; IUP[0]
  end
end
glyph advance 600
  contour 100 -12, 100 703, 300 716 off, 497 703, 497 -12, 300 -25 off
  contour 203 97, 397 97, 397 597, 203 597
  program
    SVTCA[0]; PUSH 6; MDAP[1]; PUSH 6; SRP1; PUSH 6; SRP2; PUSH 0; IP; IUP[0]
  end
end
