  contour 100 -12, 100 703, 300 716 off, 497 703, 497 -12, 300 -25 off
  contour 203 97, 397 97, 397 597, 203 597
  program
    PUSH 32767 16384; MUL; PUSH 16384; MUL; PUSH 32767; ADD; PUSH 32767; ADD; PUSH 1; ADD; PUSH 1; ADD; SDB; SVTCA[0]; PUSH 1; MDAP[0]; PUSH 0x6F 1 1; DELTAP1; PUSH 0x6F 0 1; DELTAC1; PUSH 2 0; RCVT; SVTCA[0]; SCFS
  end
