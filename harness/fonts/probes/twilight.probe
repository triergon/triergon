# The twilight zone. Observed: MIAP places a twilight point at the control
# value along the projection vector, original and current position alike;
# what a glyph program leaves in the twilight zone the next glyph's program
# finds there, as it finds what the control value program left. Glyph 0 sets
# twilight points 3 (y) and 4 (x); glyph 1 reads them and point 6, which the
# control value program set in y and then x, into its points' y.
heights 16384 1000
cvt 30 -501
maxp twilight 64
fpgm
  PUSH 0; FDEF; ENDF
end
prep
  PUSH 0; SZP0; SVTCA[0]; PUSH 6 1; MIAP[0]; SVTCA[1]; PUSH 6 0; MIAP[0]
end
glyph advance 1100
  contour 105 3, 105 1403, 903 1403 off, 903 3
  program
    PUSH 0; SZP0; SVTCA[0]; PUSH 3 0; MIAP[0]; PUSH 1; SZP0; PUSH 0; SZP2; PUSH 0 3; GC[0]; PUSH 1; SZP2; SCFS
    PUSH 0; SZP0; SVTCA[1]; PUSH 4 0; MIAP[0]; PUSH 1; SZP0; PUSH 0; SZP2; SVTCA[1]; PUSH 1 4; GC[0]; PUSH 1; SZP2; SVTCA[0]; SCFS
  end
end
glyph advance 1100
  contour 105 3, 105 1403, 903 1403 off, 903 3
  program
    PUSH 0; SZP2; SVTCA[0]; PUSH 0 3; GC[0]; PUSH 1; SZP2; SCFS
    PUSH 0; SZP2; SVTCA[0]; PUSH 1 3; GC[1]; PUSH 1; SZP2; SCFS
    PUSH 0; SZP2; SVTCA[1]; PUSH 2 4; GC[0]; PUSH 1; SZP2; SVTCA[0]; SCFS
    PUSH 0; SZP2; SVTCA[1]; PUSH 3 6; GC[0]; PUSH 1; SZP2; SVTCA[0]; SCFS
  end
end
