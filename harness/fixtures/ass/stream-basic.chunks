@chunk 3000 500
1,&H10,Top,Speaker,1,2,3,Fx,{\pos(10,10)}second, with, commas
@chunk 3000 500
2,0,Top
@chunk 3000 500
2,0,Top,,0,0,0,,the short packet before marked 2 anyway
@chunk 4000 100
 3 , 2 ,Default,,0,0,0,,spaces around read order
@chunk 4000 100
x,0,Default,,0,0,0,,non-numeric read order is 0, a duplicate
@chunk 4000 100

@chunk 4000 100
4
@dump
@check-readorder 0
@chunk 5000 100
0,0,Default,,0,0,0,,no check: read order 0 again
@check-readorder 2
@chunk 5000 100
0,0,Default,,0,0,0,,2 is not 1: still no check
@check-readorder 1
@chunk 5000 100
0,0,Default,,0,0,0,,checked again: dropped
@dump
@prune 1500
@chunk 6000 100
0,0,Default,,0,0,0,,pruned read order 0 is free again
