{
  "schema": 1,
  "id": "K0-container-demux-v1",
  "status": "experimental; broader M01/M02 requirements remain required and pending",
  "operation": "container-demux-v1",
  "reference_flags": [
    "CUSTOM_IO",
    "NOPARSE",
    "NOFILLIN"
  ],
  "reference_find_stream_info": false,
  "contract": [
    "track order, codec and codec private",
    "video dimensions and declared audio properties",
    "language, name, default and forced dispositions",
    "ordered compressed packet bytes",
    "signed presentation time",
    "source decode time (unknown when absent)",
    "duration",
    "random-access flags",
    "audio sample trim (raw delay and padding retained separately by the library)",
    "previous video keyframe seeking after EOF",
    "sequential short reads"
  ],
  "required_profiles": [
    "avc-aac-sub",
    "hevc-aac",
    "avc-ac3",
    "avc-eac3",
    "unknown-cluster",
    "xiph-lace",
    "fixed-lace",
    "ebml-lace",
    "negative-block-time",
    "blockgroup-reference",
    "codec-delay",
    "discard-padding"
  ],
  "required_targets": [
    "aarch64-unknown-linux-gnu"
  ],
  "deferred_targets": [
    "x86_64-unknown-linux-gnu",
    "armv7-linux-webos-32"
  ],
  "target_scope_authorization": "2026-10-31: owner moved qualification to native Linux ARM64; runtime policy is separately authorized by initial-delivery-runtime-v1",
  "runtime_ratio_max": 1.2,
  "memory_ratio_max_exclusive": 1.0,
  "minimum_pairs": 30,
  "confidence": 0.95,
  "absolute_limits": {
    "metadata_bytes": 1048576,
    "block_bytes": 16777216,
    "tracks": 64,
    "elements": 1000000,
    "scan_bytes": 67108864
  },
  "pending_module_requirements": [
    "incremental push input and work yields",
    "Cues/SeekHead indexed seek and preroll",
    "HDR and opaque side data",
    "chapters, tags and attachments",
    "bounded content decompression",
    "retained-capacity budgets",
    "32-bit device qualification",
    "sustained fuzzing",
    "live-allocation instrumentation"
  ],
  "runtime_optimization_ratio_target": 0.8,
  "runtime_policy": "initial-delivery-runtime-v2"
}
